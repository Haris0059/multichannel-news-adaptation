<View>
  <!-- Labels follow docs/labelling_rules.md; keep them in sync with LABELS in src/llm_label.py -->
  <Labels name="label" toName="text">
    <Label value="PERSON" background="#e6194b"/>
    <Label value="ORG" background="#3cb44b"/>
    <Label value="DATE" background="#4363d8"/>
    <Label value="NUMBER" background="#f58231"/>
  </Labels>
  <Text name="text" value="$text"/>
  <Header value="Flag this sentence (rule G8)"/>
  <Choices name="flags" toName="text" choice="multiple" showInline="true">
    <Choice value="unsure"/>
  </Choices>
  <TextArea name="note" toName="text" placeholder="Why unsure? Which rule is unclear?" rows="2"/>
</View>
